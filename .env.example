# Generate a long random value before deployment.
SECRET_KEY=replace-with-a-long-random-secret

# Development server configuration.
PORT=5000
FLASK_DEBUG=1

# Keep this 0 for local HTTP development. Use 1 only behind HTTPS.
SESSION_COOKIE_SECURE=0

# Optional custom paths. Leave commented to use the included folders.
# DATABASE_PATH=C:\path\to\fraud_detection.db
# ML_MODEL_PATH=C:\path\to\best_fraud_detection_model.pkl
# RL_MODEL_PATH=C:\path\to\fraud_q_learning_policy.pkl
